# --- Proxmox & Network Topology ---
proxmox_node          = "{{ proxmox_node_name }}"
network_bridge        = "{{ proxmox_bridge }}"
gateway_ip            = "{{ gateway_ip }}"
subnet_range          = "{{ subnet_range }}"
dns_servers           = ["{{ gateway_ip }}"]
base_domain           = "{{ base_domain }}"

# --- Resource allocations ---
default_lxc_cpu       = 2
default_lxc_ram       = 2048
default_lxc_disk      = 20

default_vm_cpu        = 4
default_vm_ram        = 8192
default_vm_disk       = 40

# --- Pidev containers (one LXC per human user) ---
# Rendered by the pidev role (roles/pidev/tasks/main.yml) as fact `pidev_tfvars`.
# Left out entirely when the fact is absent (e.g. plain `apply_tofu.yml` runs),
# in which case the HCL default `stack_pidev = []` applies.
{% if pidev_tfvars is defined and pidev_tfvars | length > 0 %}
stack_pidev = {{ pidev_tfvars | tojson }}
{% endif %}
